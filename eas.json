{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://dev.salonox.com/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://dev.salonox.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://qa.salonox.com/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://qa.salonox.com"
      }
    },
    "qa": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://qa.salonox.com/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://qa.salonox.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://www.salonox.com/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://www.salonox.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
